<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>0.1.0</Version>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
    <ClientDist Condition="'$(ClientDist)' == ''">../../web/dist</ClientDist>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Mahjong.Rules/Mahjong.Rules.csproj" />
    <ProjectReference Include="../JadeCourt.Games/JadeCourt.Games.csproj" />
    <ProjectReference Include="../JadeCourt.Chess/JadeCourt.Chess.csproj" />
    <ProjectReference Include="../JadeCourt.Poker/JadeCourt.Poker.csproj" />
    <ProjectReference Include="../JadeCourt.Words/JadeCourt.Words.csproj" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.15" />
    <Content Include="$(ClientDist)/index.html" Condition="Exists('$(ClientDist)/index.html')"
             Link="index.html" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(ClientDist)/portal.html" Condition="Exists('$(ClientDist)/portal.html')"
             Link="portal.html" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(ClientDist)/**/*" Exclude="$(ClientDist)/index.html;$(ClientDist)/portal.html;$(ClientDist)/**/*.map"
             Link="wwwroot/%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
